#!/bin/sh
# ══════════════════════════════════════════════════════════════
#  gymleco — 커밋 전 시크릿 스캔
# ══════════════════════════════════════════════════════════════
#  이 훅은 스캐너가 없거나 스캐너가 실패해도 커밋을 통과시키지 않는다
#  (fail-closed). 스캐너가 없을 때 조용히 통과하는 훅은 없는 것보다
#  나쁘다 — "훅이 있으니 안전하겠지"라고 믿게 만들기 때문이다.
#
#  활성화:  git config core.hooksPath .githooks
#  설치:    https://github.com/gitleaks/gitleaks/releases/latest
#  Docker:  GITLEAKS_DOCKER=1 git commit ...
# ══════════════════════════════════════════════════════════════

ROOT=$(git rev-parse --show-toplevel)

# ── 반드시 --staged 로 스캔한다 ────────────────────────────────
# 디렉터리 스캔(gitleaks dir)을 쓰면 .gitignore 된 빌드 산출물까지
# 훑는다. web/.next 안의 Next.js 내부 토큰이 잡혀 커밋이 막히는데,
# 정작 그 파일들은 커밋되지도 않는다.
# 커밋될 내용만 보는 것이 맞고, --staged 는 HEAD 가 없는 최초 커밋에서도
# 정상 동작한다.

run_native() {
  # gitleaks v8.19+ 는 protect/detect 를 git/dir 로 대체했다.
  if gitleaks git --help >/dev/null 2>&1; then
    gitleaks git --staged --redact --no-banner "$ROOT"
  else
    gitleaks protect --staged --redact --no-banner
  fi
}

run_docker() {
  MSYS_NO_PATHCONV=1 docker run --rm \
    -v "$ROOT":/repo -w /repo \
    zricethezav/gitleaks:latest \
    git --staged --redact --no-banner /repo
}

if command -v gitleaks >/dev/null 2>&1; then
  run_native
  STATUS=$?
elif [ "${GITLEAKS_DOCKER}" = "1" ] && command -v docker >/dev/null 2>&1; then
  run_docker
  STATUS=$?
else
  cat >&2 <<'MSG'

  ✋ 커밋이 차단됐습니다 — gitleaks 가 설치돼 있지 않습니다.

     이 저장소는 시크릿 스캔 없이는 커밋할 수 없도록 설정돼 있습니다.

     설치:    https://github.com/gitleaks/gitleaks/releases/latest
     Docker:  GITLEAKS_DOCKER=1 git commit ...

MSG
  exit 1
fi

[ $STATUS -eq 0 ] && exit 0

# gitleaks 는 시크릿을 찾으면 1 로 끝난다.
# 그 외 값은 스캐너 자체가 실패했다는 뜻이다 — 둘을 구분하지 않으면
# 크래시를 "시크릿 발견"으로 잘못 읽고 엉뚱한 곳을 뒤지게 된다.
if [ $STATUS -eq 1 ]; then
  cat >&2 <<'MSG'

  🚨 스테이징된 변경에서 시크릿으로 보이는 값이 발견됐습니다.

     1. 해당 값을 코드에서 제거하고 .env 로 옮기세요.
     2. 이미 어딘가에 노출된 적이 있는 키라면 삭제로 끝나지 않습니다.
        반드시 재발급(로테이션) 하세요.
     3. 오탐이라면 .gitleaks.toml 의 allowlist 를 좁게 수정하세요.
        --no-verify 로 우회하지 마세요.

MSG
else
  cat >&2 <<MSG

  ⚠️ 시크릿 스캐너가 오류로 종료했습니다 (exit ${STATUS}).

     시크릿이 발견된 것이 아니라 스캐너 자체가 실패한 것입니다.
     스캔하지 못한 상태로 커밋을 통과시키지 않습니다.

     .gitleaks.toml 의 정규식을 확인하세요 — gitleaks 는 Go 의 RE2 를
     쓰므로 전방탐색 (?!...) 을 넣으면 파싱 단계에서 죽습니다.

MSG
fi

exit $STATUS
